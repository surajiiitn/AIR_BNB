<% layout("/layouts/boilerplate.ejs") %>

<body>
    <div class="rows">
    <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
    <div class="card col-8 listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="No image available" style="height:  20rem;">
                <div class="card-body">
                    <p class="card-text">
                        <ul>
                            <li><%= listing.description %></li>
                            <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
                            <li><%= listing.location %></li>
                            <li><%= listing.country %></li>
                        </ul>
                        <br>
                    </p>
                </div>
            </div>
    
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark mb-2 edit-btn">Edit</a>
    <form action="/listings/<%= listing._id%>?_method=DELETE" method="POST">
        <button class="btn btn-dark mb-3">Delete</button>
    </form>
     </div>


    <div class="col-8 offset-2 mb-3">
        <h4>Leave a Review</h4>
        <hr>
        <form action="/listings/<%=listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="rating" class="fo`rm-label">Rating</label>
                <input type="range" min="1" max="5" step="1" id="rating" name="review[rating]" value="1" class="form-range">
            </div>
            <div class="mb-3">
                <label for="comment" class="form-label">comments</label>
                <textarea name="review[comment]" id="comment" cols="38" rows="3" class="form-control" required></textarea>

            </div>
            <button class="btn btn-outline-dark mb-2">Submit</button>
        </form>

        <hr>

        <p><b>All Reviews</b></p>
        <div class="row">
            <%for(review of listing.reviews){%>
                <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Motu</h5>
                        <p class="card-text"><%=review.comment%></p>
                        <p class="card-text"> Rating : <%= review.rating%> stars</p>
                    </div>
                </div>
            <%}%>
        </div>
    </div>
</div>
</body>
`