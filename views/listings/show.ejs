<% layout("/layouts/boilerplate.ejs") %>


    <div class="rows">
    <div class="col-8 offset-2">
    <h3>Listing Details </h3>
    <div class="card col-8 listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="No image available" style="height:  20rem;">
                <div class="card-body">
                    <p class="card-text">
                        <ul>
                            <li><%= listing.title %></li>
                            <li><%= listing.description %></li>
                            <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
                            <li><%= listing.location %></li>
                            <li><%= listing.country %></li>
                        </ul>
                        <br>
                    </p>
                </div>
            </div>
    
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark mb-2 edit-btn">Edit</a>
    <form action="/listings/<%= listing._id%>?_method=DELETE" method="POST">
        <button class="btn btn-dark mb-3">Delete</button>
    </form>
     </div>
</div>
